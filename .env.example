# ============================================================
# Taximun — Variables de entorno
# ============================================================
# MODO DEMO LOCAL (sin variables): deja este archivo sin configurar y la app
# arranca con datos de demostración en memoria (Barcelona) + login rápido por
# rol en /auth. Ideal para desarrollar y enseñar la producto.
#   pnpm install && pnpm dev  →  http://localhost:3000

# ---- PRODUCCIÓN: Supabase (obligatorio para datos reales) ----
# Crea un proyecto gratis en https://supabase.com y aplica las migraciones
# de supabase/migrations/ en el SQL Editor (en orden por fecha).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Frontend (mismas credenciales que arriba, prefijo VITE_)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- OPCIONAL: pagos con tarjeta (Stripe) ----
# Sin estas claves, los viajes en efectivo funcionan completo y los de
# tarjeta se autorizan en modo demo automático.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# ---- OPCIONAL: modo demo local ----
# Intervalo (ms) del planificador que procesa reservas programadas y
# sincroniza las colas FIFO por zona. Por defecto 30000 (30 s).
#TAXIMUN_LOCAL_SCHEDULER_MS=30000

# ---- OPCIONAL: legado / infraestructura de la plantilla ----
DATABASE_URL=
JWT_SECRET=
ADMIN_EMAILS=
OWNER_OPEN_ID=
OAUTH_SERVER_URL=
VITE_APP_ID=
